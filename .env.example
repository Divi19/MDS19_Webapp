# Backend
USE_DUMMY_PREDICTOR=true
MODEL_CHECKPOINT_PATH=
MODEL_DATA_ROOT=
# Google Drive file ID of the gzipped webapp_database tarball main.py downloads
# on first boot. Only needs overriding for a non-default model data bank (e.g.
# a v7 staging deploy) — leave blank to use the current production bank.
MODEL_DATA_ARCHIVE_ID=
# "densenet121" (baseline) or "h0mini" (v7 dual-crop). Must match whatever
# produced MODEL_DATA_ROOT — see backend/app/core/config.py.
ENCODER_BACKEND=densenet121
# Spatial smoothing (Path A) — on by default.
ENABLE_SMOOTHING=true
SMOOTHING_ALPHA=0.6
SUPABASE_URL=
SUPABASE_KEY=

# Modal GPU inference
USE_MODAL_INFERENCE=false
MODAL_PREDICT_URL=https://brandonchiew--mds19-v7-inference-v7predictor-predict.modal.run
MODAL_HEALTH_URL=https://brandonchiew--mds19-v7-inference-v7predictor-health.modal.run
MODAL_GRADCAM_URL=https://brandonchiew--mds19-v7-gradcam-v7gradcam-explain-batch.modal.run
MODAL_REQUEST_TIMEOUT=150
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RELAY_BUCKET=model-relay

# CORS — frontend origins allowed to call this API (comma-separated or JSON
# list depending on how pydantic-settings parses it; defaults to localhost:3000)
CORS_ORIGINS=

# DAVID pathway enrichment (davidbioinformatics.nih.gov) — register at
# davidbioinformatics.nih.gov/webservice/register.htm using an organisational
# email (not a personal address, it will be rejected). No API key system —
# the registered email itself is the credential. Leave blank to disable
# /api/pathways (returns 501) rather than requiring this for the app to run.
DAVID_EMAIL=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
